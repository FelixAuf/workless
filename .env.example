# Required on first start; remove ADMIN_PASSWORD after the initial admin was created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OPENAI_API_KEY=
DATABASE_PATH=data/career-radar.sqlite3
# Only for local HTTP development. Keep true behind Coolify HTTPS.
COOKIE_SECURE=true
SEARCH_MODEL=gpt-4.1-mini
EVALUATION_MODEL=gpt-4.1-mini
SESSION_HOURS=168
API_TIMEOUT_SECONDS=90
MAX_OUTPUT_TOKENS=6000
MAX_RUN_TOKENS=100000
MAX_RUN_USD=2
# Estimates only: adjust to the selected models and current account pricing.
INPUT_USD_PER_MILLION=0.4
OUTPUT_USD_PER_MILLION=1.6
WEB_SEARCH_USD_PER_CALL=0.01
